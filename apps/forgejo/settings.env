# Non-secret Forgejo settings. The image's environment-to-ini writes every FORGEJO__<section>__<KEY> into app.ini at each start;
# removing a line here does NOT remove it from app.ini (it stays in the data volume). Secrets: secrets/coke/forgejo.env.sops.
FORGEJO__server__DOMAIN=git.sapphic.world
FORGEJO__server__ROOT_URL=https://git.sapphic.world/
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__START_SSH_SERVER=true
FORGEJO__server__SSH_DOMAIN=git.sapphic.world
FORGEJO__server__SSH_PORT=22
FORGEJO__server__SSH_LISTEN_PORT=2222
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__security__REVERSE_PROXY_TRUSTED_PROXIES=100.127.17.6/32
FORGEJO__service__DISABLE_REGISTRATION=false
FORGEJO__service__ALLOW_ONLY_EXTERNAL_REGISTRATION=true
FORGEJO__service__ENABLE_INTERNAL_SIGNIN=false
FORGEJO__service__REQUIRE_SIGNIN_VIEW=false
FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION=true
FORGEJO__oauth2_client__USERNAME=preferred_username
FORGEJO__openid__ENABLE_OPENID_SIGNIN=false
FORGEJO__openid__ENABLE_OPENID_SIGNUP=false
FORGEJO__mailer__ENABLED=false
FORGEJO__actions__ENABLED=true
