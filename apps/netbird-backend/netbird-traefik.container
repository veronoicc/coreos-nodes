[Unit]
Description=Traefik for the NetBird backend (TLS via Let's Encrypt)
Wants=network-online.target netbird-server.service netbird-dashboard.service
After=network-online.target netbird-server.service netbird-dashboard.service
RequiresMountsFor=/var/data
# Static config with the ACME email, generated by scripts/init-netbird-backend.sh.
ConditionPathExists=/var/data/netbird-backend/traefik.yml

[Container]
# v3.7.13+ is what NetBird's own getting-started.sh requires (aliasHeadersStrategy).
Image=docker.io/library/traefik:v3.7.14
ContainerName=netbird-traefik
Network=netbird-backend.network
PublishPort=80:80
PublishPort=443:443
# File provider only: no container socket is mounted.
Volume=/var/data/netbird-backend/traefik.yml:/etc/traefik/traefik.yml:ro,Z
Volume=/etc/containers/systemd/apps/netbird-backend/traefik-dynamic.yml:/etc/traefik/dynamic.yml:ro,z
Volume=/var/data/netbird-backend/letsencrypt:/letsencrypt:Z

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
