[Unit]
Description=NetBird server (management, signal, relay, STUN)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/data
# Generated by scripts/init-netbird-backend.sh; skipped (not crash-looping) until then.
ConditionPathExists=/var/data/netbird-backend/config.yaml

[Container]
# Pinned; bump together with the dashboard via git (apps-sync restarts only changed units).
Image=docker.io/netbirdio/netbird-server:0.82.1
ContainerName=netbird-server
Network=netbird-backend.network
# STUN needs direct UDP, it cannot go through the reverse proxy.
PublishPort=3478:3478/udp
Volume=/var/data/netbird-backend/netbird:/var/lib/netbird:Z
Volume=/var/data/netbird-backend/config.yaml:/etc/netbird/config.yaml:ro,Z

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
