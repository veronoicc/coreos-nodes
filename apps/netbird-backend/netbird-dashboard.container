[Unit]
Description=NetBird dashboard
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/data
# Generated by scripts/init-netbird-backend.sh.
ConditionPathExists=/var/data/netbird-backend/dashboard.env

[Container]
Image=docker.io/netbirdio/dashboard:v2.96.1
ContainerName=netbird-dashboard
Network=netbird-backend.network
EnvironmentFile=/var/data/netbird-backend/dashboard.env

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
