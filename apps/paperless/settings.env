# Non-secret Paperless-ngx settings (the secret key and the OIDC client config are in /var/data/secrets/paperless.env, see README.md).
PAPERLESS_URL=https://paperless.service.veronoi.cc
# The URL stays the service name: mesh peers use it directly, the internet only reaches /share/ (apps/paperless/routes.yml).
PAPERLESS_REDIS=redis://paperless-valkey:6379
PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu+eng
# ecstasy's Traefik terminates TLS and reaches Paperless over the mesh; the container sees ecstasy's NetBird IP (100.127.17.6,
# stable per peer) as the source (the client's fwmark avoids netavark's masquerade, see build.py netbird_quadlet). Trust exactly that
# address for X-Forwarded-*, so Django builds https://paperless.service.veronoi.cc URLs (the OIDC callback depends on it).
PAPERLESS_USE_X_FORWARD_HOST=true
PAPERLESS_USE_X_FORWARD_PORT=true
PAPERLESS_PROXY_SSL_HEADER=["HTTP_X_FORWARDED_PROTO", "https"]
PAPERLESS_TRUSTED_PROXIES=100.127.17.6
# Login only through Authentik (OIDC). The provider itself is in the secret env file: Paperless does not expand variables
# inside PAPERLESS_SOCIALACCOUNT_PROVIDERS, so the client secret has to be in it.
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_DISABLE_REGULAR_LOGIN=true
PAPERLESS_REDIRECT_LOGIN_TO_SSO=true
PAPERLESS_SOCIAL_AUTO_SIGNUP=true
PAPERLESS_ACCOUNT_ALLOW_SIGNUPS=false
PAPERLESS_LOGOUT_REDIRECT_URL=https://auth.service.veronoi.cc/application/o/paperless/end-session/
