[Unit]
Description=scanservjs (web scan UI for the HP eSCL scanner, output into Paperless's consume folder)
Wants=network-online.target netbird.service
# netbird.service is the baked NetBird client: the mesh interface (wt0) has to exist before the port can be bound to the
# mesh address (and the scanner is reached through the mesh). It is only ordered, not required; if the bind still fails the
# unit is retried (below).
After=network-online.target netbird.service
RequiresMountsFor=/var/data
# Retry forever: after a reboot the mesh address appears some seconds after the client started.
StartLimitIntervalSec=0

[Container]
Image=docker.io/sbs20/scanservjs:3.3.0
ContainerName=scanservjs
# MTU 1140 for the path to the printer, see scanservjs.network.
Network=scanservjs.network
# Reachable ONLY on the mesh address of this node, never on 0.0.0.0 (scanservjs has no login of its own). The same address
# is in apps/scanservjs/routes.yml; edit both if the peer is re-registered.
PublishPort=100.127.197.215:8081:8080
# The scanner is configured statically (AIRSCAN_DEVICES in settings.env), mDNS does not cross the container network. The
# hostname is pinned here instead of a DNS lookup: keep a DHCP reservation for the printer, see README.md.
AddHost=printer.device:10.0.0.34
EnvironmentFile=/etc/containers/systemd/apps/scanservjs/settings.env
# Mounted as a single file: the rest of /etc/scanservjs (config.default.js, the template) stays as the image ships it.
Volume=/etc/containers/systemd/apps/scanservjs/config.local.js:/etc/scanservjs/config.local.js:ro,z
# Static devices only (no mDNS/WSD discovery): without it sane-airscan lists no scanner here, see airscan-static.conf.
Volume=/etc/containers/systemd/apps/scanservjs/airscan-static.conf:/etc/sane.d/airscan.d/static.conf:ro,z
# Output directory of scanservjs = Paperless's consume folder (apps/paperless/paperless-consume.volume). :z because two
# containers (different SELinux categories) share it.
Volume=paperless-consume.volume:/var/lib/scanservjs/output:z

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
