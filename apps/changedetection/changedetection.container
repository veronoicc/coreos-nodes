[Unit]
Description=changedetection.io (changedetection.sapphic.world, mesh only, behind Authentik's embedded outpost in proxy mode)
# The browser is only wanted: watches on the plain HTTP fetcher keep working without it.
Wants=network-online.target changedetection-browser.service
After=network-online.target changedetection-browser.service
RequiresMountsFor=/var/data

[Container]
Image=docker.io/dgtlmoon/changedetection.io:0.70.4
ContainerName=changedetection
Network=changedetection.network
# No PublishPort: changedetection's own password stays off, so the only way in is Authentik's embedded outpost (inside
# authentik-server), which logs the user in and proxies to http://changedetection:5000 over authentik.network
# (internal_host in apps/authentik/changedetection-blueprint.yaml). The browser is not on authentik.network.
Network=authentik.network
# Playwright fetcher -> sockpuppetbrowser (changedetection-browser.container) over CDP on the private network. sockpuppetbrowser
# drops --disable-blink-features=AutomationControlled in headful mode (chrome.py), leaving navigator.webdriver=true; query-string
# flags are appended after that, so this puts it back.
Environment=PLAYWRIGHT_DRIVER_URL=ws://changedetection-browser:3000?--disable-blink-features=AutomationControlled
# Live updates (Socket.IO): python-engineio derives the allowed origin from X-Forwarded-Proto, and on WebSocket upgrades Traefik
# sends `wss` (the outpost passes it on), so the derived wss://<host> never matches the browser's Origin and every handshake gets
# 400 "Not an accepted origin". Name the one real origin instead (changedetectionio/realtime/socket_server.py reads this).
Environment=SOCKETIO_CORS_ORIGINS=https://changedetection.sapphic.world
# No call-home version check (changedetectionio/flask_app.py).
Environment=DISABLE_VERSION_CHECK=true
Volume=changedetection-data.volume:/datastore

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
