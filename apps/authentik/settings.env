# Non-secret Authentik/PostgreSQL settings (the secrets are in /var/data/secrets/authentik.env, see README.md).
POSTGRES_USER=authentik
POSTGRES_DB=authentik
AUTHENTIK_POSTGRESQL__HOST=authentik-postgres
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
# Private bridge network inside the node, the PostgreSQL image has no TLS.
AUTHENTIK_POSTGRESQL__SSLMODE=disable
# ecstasy's Traefik reaches Authentik over the mesh and the container sees ecstasy's NetBird IP (100.127.17.6, stable per peer)
# as the source, since the client's fwmark no longer hits netavark's masquerade (see build.py netbird_quadlet). Trust only that
# address for X-Forwarded-*. NOT the authentik.network gateway (10.89.10.1): changedetection is on that network too, and its
# hairpin connections to the published port would arrive masqueraded as the gateway, letting it forge X-Forwarded-* headers.
# The port only listens on the mesh address.
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=100.127.17.6/32
# No telemetry: no Sentry error reporting, no update check call-home.
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
