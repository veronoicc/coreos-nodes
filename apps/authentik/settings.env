# Non-secret Authentik/PostgreSQL settings (the secrets are in /var/data/secrets/authentik.env, see README.md).
POSTGRES_USER=authentik
POSTGRES_DB=authentik
AUTHENTIK_POSTGRESQL__HOST=authentik-postgres
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
# Private bridge network inside the node, the PostgreSQL image has no TLS.
AUTHENTIK_POSTGRESQL__SSLMODE=disable
# Requests arrive from ecstasy's Traefik over the NetBird mesh (100.64.0.0/10): trust its X-Forwarded-* headers, nothing else.
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=100.64.0.0/10
# No telemetry: no Sentry error reporting, no update check call-home.
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
