[Network]
# Private network of the Authentik stack plus changedetection (authentik-server's embedded outpost proxies to it, see
# apps/changedetection/changedetection.container). The database is only reachable from here; nothing is published except the
# Authentik HTTP port on the mesh address (authentik-server.container). The gateway is deliberately not a trusted proxy (settings.env).
Subnet=10.89.10.0/24
Gateway=10.89.10.1
