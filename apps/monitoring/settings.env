# Non-secret Grafana settings (admin password, OIDC client secret and the datasource password are in /var/data/secrets/monitoring.env, see README.md).
# Grafana v13.3.1; keys are [section] key of conf/defaults.ini as GF_<SECTION>_<KEY>.
GF_SERVER_ROOT_URL=https://grafana.service.veronoi.cc
# Login only through Authentik (generic OAuth). The callback is ROOT_URL/login/generic_oauth. [auth] oauth_auto_login is deprecated
# (pkg/setting/setting.go:2174): auto_login inside the provider section replaces it.
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Authentik
GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN=true
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.service.veronoi.cc/application/o/authorize/
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.service.veronoi.cc/application/o/token/
GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.service.veronoi.cc/application/o/userinfo/
GF_AUTH_GENERIC_OAUTH_SIGNOUT_REDIRECT_URL=https://auth.service.veronoi.cc/application/o/grafana/end-session/
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
# Creates the Grafana user at the first login; who may log in is decided by Authentik (application bound to `authentik Admins`).
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
# Only members of the Authentik group `authentik Admins` get in, as Grafana Admin (org Admin + server admin). The expression yields
# 'GrafanaAdmin' for members and `false` for everyone else; with role_attribute_strict a login without a valid role is refused
# (pkg/login/social/connectors/generic_oauth.go postProcessUserInfo, social_base.go extractRoleAndAdminOptional).
# skip_org_role_sync stays off (default): the path is evaluated at every login. The `groups` claim is in Authentik's `profile`
# scope (blueprints/system/providers-oauth2.yaml), which the userinfo endpoint returns.
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'authentik Admins') && 'GrafanaAdmin'
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
# Public dashboards inside third-party iframes: only drops X-Frame-Options (pkg/middleware/middleware.go:63). An anonymous viewer
# needs no cookie (/api/public/dashboards/* has no auth middleware), so cookie_samesite stays at lax. Both entrypoints are https.
GF_SECURITY_ALLOW_EMBEDDING=true
GF_SECURITY_COOKIE_SECURE=true
