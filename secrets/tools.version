# Binaries secrets-sync downloads (linux amd64) into /var/data/bin and verifies by sha256 before every use.
# KEY=VALUE only; read by bash, no other parsing. Bump a version together with its checksums.
#   sops:      https://github.com/getsops/sops/releases/download/v<sops_version>/sops-v<sops_version>.linux.amd64
#              sha256 from the release's sops-v<version>.checksums.txt
#   age-keygen: the age release tarball age-v<age_version>-linux-amd64.tar.gz (member age/age-keygen); age publishes no
#              checksum file, so both sha256 values below were computed from the official release asset.
sops_version=3.13.3
sops_sha256=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b
age_version=1.3.2
age_archive_sha256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
age_keygen_sha256=0a0009db842259d6717f7eeb30acb6b90d2a2eb924c6acd0a0db0ca1f1537899
