#!/bin/bash
# Decrypt this node's SOPS-encrypted secrets from the repo into files and restart only the units whose file changed.
#   secrets/tools.version       pinned sops + age-keygen (linux amd64): versions and sha256, KEY=VALUE lines
#   secrets/<node>/targets.conf one target per line: <encrypted-file> <destination> <mode> <owner:group|-> <units,comma|->
#   secrets/<node>/<name>.sops  SOPS file encrypted to this node's age key (and the admin's), rendered WHOLE to the
#                               destination; the format comes from the name: *.env.sops dotenv, *.yaml.sops/*.yml.sops
#                               yaml, *.json.sops json, *.ini.sops ini, anything else binary (see sops_type).
#                               <node> = short hostname, a node only ever reads its own folder
# The node generates its own age key (never leaves the node) in KEY_DIR/age.key (0600) on first run and publishes the
# public key in KEY_DIR/age.pub (0644) and the journal; scripts/node-key.sh fetches it, scripts/add-node.sh makes it a
# recipient. Without a manifest, or before any listed encrypted file exists, this logs one line and exits 0. A listed
# file that does not exist yet is skipped with one log line (the others still render); an existing file that fails to
# decrypt or validate fails everything.
# Env: APPS_REPO_URL, APPS_BRANCH (/etc/apps-sync.env, shared with apps-sync);
#      SECRETS_SRC_DIR (local repo root instead of downloading; for tests), SECRETS_KEY_DIR, SECRETS_BIN_DIR,
#      SECRETS_LOCK, SECRETS_HOSTNAME_FILE, SECRETS_GITHUB_URL, SECRETS_TIMEOUT.
set -euo pipefail
umask 077

KEY_DIR=${SECRETS_KEY_DIR:-/var/data/secrets}
BIN_DIR=${SECRETS_BIN_DIR:-/var/data/bin}
LOCK=${SECRETS_LOCK:-/run/secrets-sync.lock}
HOSTNAME_FILE=${SECRETS_HOSTNAME_FILE:-/etc/hostname}
GITHUB_URL=${SECRETS_GITHUB_URL:-https://github.com}
APPS_BRANCH=${APPS_BRANCH:-main}
KEY=$KEY_DIR/age.key
PUB=$KEY_DIR/age.pub

die() { echo "secrets-sync: $*" >&2; exit 1; }
log() { echo "secrets-sync: $*" >&2; }

# Per-run state (globals: the EXIT trap runs after main returns).
work=
NODE=
SRC=
SOPS=
KEYGEN=
declare -A PIN=()
declare -a TMPS=()                                                       # temp files to remove on exit
declare -a T_FILE=() T_DEST=() T_MODE=() T_OWNER=() T_UNITS=() T_TMP=()  # manifest targets, parallel arrays

# shellcheck disable=SC2329 # runs as the EXIT trap
cleanup() {
    local rc=$?
    trap - EXIT
    if [ "${#TMPS[@]}" -gt 0 ]; then rm -f "${TMPS[@]}"; fi
    [ -z "$work" ] || rm -rf "$work"
    exit "$rc"
}

sha_of() { sha256sum "$1" | cut -d' ' -f1; }

node_name() {
    local n
    [ -f "$HOSTNAME_FILE" ] || die "$HOSTNAME_FILE not found"
    n=$(head -n1 "$HOSTNAME_FILE")
    n=${n%%.*}
    [[ $n =~ ^[A-Za-z0-9_-]+$ ]] || die "cannot derive a node name from $HOSTNAME_FILE"
    NODE=$n
}

# fetch_repo: SRC = repo root (tarball like apps-sync, or SECRETS_SRC_DIR).
fetch_repo() {
    if [ -n "${SECRETS_SRC_DIR:-}" ]; then
        SRC=$SECRETS_SRC_DIR
    else
        [ -n "${APPS_REPO_URL:-}" ] || die "APPS_REPO_URL is not set (see /etc/apps-sync.env)"
        curl -fsSL --retry 3 --max-time 120 -o "$work/repo.tar.gz" \
            "${APPS_REPO_URL%/}/archive/refs/heads/$APPS_BRANCH.tar.gz" || die "downloading the repo failed"
        mkdir "$work/repo"
        tar -xzf "$work/repo.tar.gz" -C "$work/repo" --strip-components=1
        SRC=$work/repo
    fi
    [ -d "$SRC/secrets" ] || die "no secrets/ directory in the repo, refusing to continue"
}

# read_pin: PIN[<key>] from secrets/tools.version, validated.
read_pin() {
    local file=$SRC/secrets/tools.version k v
    [ -f "$file" ] || die "secrets/tools.version not found in the repo"
    while IFS='=' read -r k v || [ -n "$k" ]; do
        case $k in
            sops_version | sops_sha256 | age_version | age_archive_sha256 | age_keygen_sha256) PIN[$k]=$v ;;
        esac
    done < "$file"
    for k in sops_version age_version; do
        [[ ${PIN[$k]:-} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "secrets/tools.version: missing or invalid $k=x.y.z"
    done
    for k in sops_sha256 age_archive_sha256 age_keygen_sha256; do
        [[ ${PIN[$k]:-} =~ ^[0-9a-f]{64}$ ]] || die "secrets/tools.version: missing or invalid $k="
    done
}

# download <url> <file>
download() {
    curl -fsSL --retry 3 --max-time 600 -o "$2" "$1" || die "downloading $1 failed"
}

# prune_old <glob prefix> <keep>: remove binaries of other versions.
prune_old() {
    local old
    for old in "$BIN_DIR/$1"-*; do
        [ "$old" = "$2" ] || rm -f "$old"
    done
}

# ensure_sops / ensure_age_keygen: SOPS / KEYGEN = verified pinned binary, downloaded on demand into BIN_DIR.
ensure_sops() {
    local v=${PIN[sops_version]} tmp
    SOPS=$BIN_DIR/sops-$v
    if [ -x "$SOPS" ] && [ "$(sha_of "$SOPS")" = "${PIN[sops_sha256]}" ]; then return; fi
    install -d -m 0755 "$BIN_DIR"
    tmp=$(mktemp "$BIN_DIR/.sops.XXXXXX")
    TMPS+=("$tmp")
    download "$GITHUB_URL/getsops/sops/releases/download/v$v/sops-v$v.linux.amd64" "$tmp"
    [ "$(sha_of "$tmp")" = "${PIN[sops_sha256]}" ] || die "sops $v: checksum mismatch, refusing to use the download"
    chmod 0755 "$tmp"
    mv -f "$tmp" "$SOPS"
    prune_old sops "$SOPS"
}

ensure_age_keygen() {
    local v=${PIN[age_version]} tmp
    KEYGEN=$BIN_DIR/age-keygen-$v
    if [ -x "$KEYGEN" ] && [ "$(sha_of "$KEYGEN")" = "${PIN[age_keygen_sha256]}" ]; then return; fi
    install -d -m 0755 "$BIN_DIR"
    download "$GITHUB_URL/FiloSottile/age/releases/download/v$v/age-v$v-linux-amd64.tar.gz" "$work/age.tar.gz"
    [ "$(sha_of "$work/age.tar.gz")" = "${PIN[age_archive_sha256]}" ] || die "age $v: checksum mismatch, refusing to use the download"
    tmp=$(mktemp "$BIN_DIR/.age-keygen.XXXXXX")
    TMPS+=("$tmp")
    tar -xzOf "$work/age.tar.gz" age/age-keygen > "$tmp" || die "age $v: age/age-keygen not found in the archive"
    [ "$(sha_of "$tmp")" = "${PIN[age_keygen_sha256]}" ] || die "age-keygen $v: checksum mismatch, refusing to use the download"
    chmod 0755 "$tmp"
    mv -f "$tmp" "$KEYGEN"
    prune_old age-keygen "$KEYGEN"
}

# ensure_key: create the node's own age key if missing, publish its public key.
ensure_key() {
    local tmp pub
    install -d -m 0700 "$KEY_DIR"
    if [ ! -f "$KEY" ]; then
        tmp=$(mktemp "$KEY_DIR/.age.key.XXXXXX")
        TMPS+=("$tmp")
        "$KEYGEN" > "$tmp" 2> /dev/null || die "age-keygen failed to generate $KEY"
        mv -f "$tmp" "$KEY"
    fi
    chmod 0600 "$KEY"
    pub=$("$KEYGEN" -y "$KEY" 2> /dev/null) || die "$KEY is not a valid age key file"
    [[ $pub =~ ^age1[a-z0-9]{58}$ ]] || die "$KEY did not yield an age public key"
    if [ "$(cat "$PUB" 2> /dev/null || true)" != "$pub" ]; then
        tmp=$(mktemp "$KEY_DIR/.age.pub.XXXXXX")
        TMPS+=("$tmp")
        echo "$pub" > "$tmp"
        chmod 0644 "$tmp"
        mv -f "$tmp" "$PUB"
        log "node age public key: $pub (scripts/add-node.sh $NODE $pub)"
    fi
}

# read_manifest: validate secrets/<node>/targets.conf into the T_* arrays; exit 0 when there is nothing to render yet.
read_manifest() {
    local dir=$SRC/secrets/$NODE conf file dest mode owner units extra n=0
    local -a missing=()
    conf=$dir/targets.conf
    if [ ! -f "$conf" ]; then
        log "no secrets/$NODE/targets.conf in the repo, nothing to do"
        exit 0
    fi
    while read -r file dest mode owner units extra || [ -n "${file:-}" ]; do
        [ -n "${file:-}" ] && [[ $file != \#* ]] || continue
        [ -z "${extra:-}" ] || die "targets.conf: too many fields for $file"
        [[ $file =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "targets.conf: invalid file name '$file'"
        [[ ${dest:-} =~ ^/[^[:space:]]*[^[:space:]/]$ ]] || die "targets.conf: $file needs an absolute destination"
        [[ ${mode:-} =~ ^[0-7]{3,4}$ ]] || die "targets.conf: $file needs an octal mode"
        [[ ${owner:-} =~ ^(-|[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+)$ ]] || die "targets.conf: $file needs owner:group or -"
        [[ ${units:-} =~ ^(-|[A-Za-z0-9_.@:-]+(,[A-Za-z0-9_.@:-]+)*)$ ]] || die "targets.conf: $file needs units (comma separated) or -"
        if [ -f "$dir/$file" ]; then
            n=$((n + 1))
            T_FILE+=("$file") T_DEST+=("$dest") T_MODE+=("$mode") T_OWNER+=("$owner") T_UNITS+=("$units")
        else
            missing+=("$file")
        fi
    done < "$conf"
    if [ "$n" -eq 0 ]; then
        log "secrets/$NODE has no encrypted files in the repo yet, nothing to do"
        exit 0
    fi
    # Listed but not there yet (the admin adds files step by step, the manifest ships ahead): skip, never fail the others.
    for file in "${missing[@]}"; do
        log "skipping $file: not in secrets/$NODE/ yet"
    done
}

# sops_run <args>: sops with only this node's key; nothing from the caller's environment or home directory.
sops_run() {
    env -i PATH="$PATH" HOME="$work/home" SOPS_AGE_KEY_FILE="$KEY" timeout "${SECRETS_TIMEOUT:-60}" "$SOPS" "$@"
}

# check_dotenv <name> <file>: the decrypted dotenv must hold KEY=value lines, none empty. Never prints a value.
check_dotenv() {
    local line n=0 ln=0
    while IFS= read -r line || [ -n "$line" ]; do
        ln=$((ln + 1))
        [[ -z ${line//[[:space:]]/} || $line =~ ^[[:space:]]*# ]] && continue
        if [[ $line =~ ^([A-Za-z_][A-Za-z0-9_.-]*)=$ ]]; then
            die "$1: ${BASH_REMATCH[1]} has an empty value"
        fi
        [[ $line =~ ^[A-Za-z_][A-Za-z0-9_.-]*=. ]] || die "$1: decrypted line $ln is not KEY=value"
        n=$((n + 1))
    done < "$2"
    [ "$n" -gt 0 ] || die "$1 decrypts to no KEY=value lines"
}

# sops_type <name>: the sops input/output type, derived from the encrypted file's name (before the .sops suffix):
# *.env.sops dotenv, *.yaml.sops and *.yml.sops yaml, *.json.sops json, *.ini.sops ini, anything else binary.
# New targets of any format therefore need no change to this (baked) script, only a targets.conf line.
sops_type() {
    case $1 in
        *.env.sops) echo dotenv ;;
        *.yaml.sops | *.yml.sops) echo yaml ;;
        *.json.sops) echo json ;;
        *.ini.sops) echo ini ;;
        *) echo binary ;;
    esac
}

# decrypt <name> <temp file>: SOPS file -> its whole plaintext in the temp file (mode 0600 from creation).
# dotenv must hold KEY=value lines; every other format must decrypt to something non-empty (sops itself rejects
# malformed yaml/json/ini, so an empty result can only be an empty binary file).
decrypt() {
    local err=$work/err type
    type=$(sops_type "$1")
    sops_run --decrypt --input-type "$type" --output-type "$type" "$SRC/secrets/$NODE/$1" > "$2" 2> "$err" \
        || die "decrypting secrets/$NODE/$1 failed (not encrypted to this node's key, or tampered?): $(head -n 12 "$err")"
    if [ "$type" = dotenv ]; then
        check_dotenv "secrets/$NODE/$1" "$2"
    else
        [ -s "$2" ] || die "secrets/$NODE/$1 decrypts to an empty file"
    fi
}

render_all() {
    local i dest
    for i in "${!T_FILE[@]}"; do
        dest=${T_DEST[$i]}
        mkdir -p "${dest%/*}"
        T_TMP[i]=$(mktemp "${dest%/*}/.${dest##*/}.XXXXXX")
        TMPS+=("${T_TMP[$i]}")
        decrypt "${T_FILE[$i]}" "${T_TMP[$i]}"
    done
}

# commit_all: replace changed destinations (atomic rename), write the units of changed targets to $work/units.
commit_all() {
    local i tmp dest
    for i in "${!T_FILE[@]}"; do
        tmp=${T_TMP[$i]}
        dest=${T_DEST[$i]}
        chmod "${T_MODE[$i]}" "$tmp"
        [ "${T_OWNER[$i]}" = - ] || chown "${T_OWNER[$i]}" "$tmp"
        if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
            chmod "${T_MODE[$i]}" "$dest"
            [ "${T_OWNER[$i]}" = - ] || chown "${T_OWNER[$i]}" "$dest"
            rm -f "$tmp"
        else
            mv -f "$tmp" "$dest"
            log "updated $dest"
            [ "${T_UNITS[$i]}" = - ] || echo "${T_UNITS[$i]}" | tr ',' '\n'
        fi
    done > "$work/units"
    log "ok, ${#T_FILE[@]} target(s)"
}

main() {
    local unit rc=0
    exec 9> "$LOCK"
    flock 9
    work=$(mktemp -d)
    trap cleanup EXIT
    mkdir "$work/home"
    node_name
    fetch_repo
    read_pin
    ensure_age_keygen
    ensure_key
    read_manifest
    ensure_sops
    render_all
    commit_all
    while read -r unit; do
        systemctl restart "$unit" || { log "restarting $unit failed"; rc=1; }
    done < <(sort -u "$work/units")
    exit "$rc"
}

main "$@"
