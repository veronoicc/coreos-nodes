#!/bin/bash
# Render secrets from Proton Pass into files on this node and restart only the units whose secrets changed.
#   secrets/targets.conf   one target per line: <template> <destination> <mode> <owner:group|-> <units,comma|->
#   secrets/<name>.tpl     lines KEY=pass://{node}/item/field (fetched) or KEY=literal; {node} = short hostname
#   secrets/pass-cli.version   version=<x.y.z> and sha256=<hex> of the pinned pass-cli linux-x86_64 binary
# The only secret kept on the node is the Proton Pass personal access token (PAT) in SECRETS_PAT_FILE: one line,
# `PROTON_PASS_PERSONAL_ACCESS_TOKEN=pst_...::...` (or the bare token). Without it this exits 0 doing nothing.
# Every run logs in again (PAT sessions last 2 h) with the pass-cli session on tmpfs, renders every target to a
# temp file first, and only then replaces changed destinations. Any failure keeps all existing files, restarts
# nothing and exits non-zero. Secret values are never printed.
# Env: APPS_REPO_URL, APPS_BRANCH (/etc/apps-sync.env, shared with apps-sync);
#      SECRETS_SRC_DIR (local repo root instead of downloading; for tests), SECRETS_PAT_FILE, SECRETS_BIN_DIR,
#      SECRETS_SESSION_DIR, SECRETS_LOCK, SECRETS_HOSTNAME_FILE, SECRETS_RELEASE_URL, SECRETS_TIMEOUT.
set -euo pipefail
umask 077

PAT_FILE=${SECRETS_PAT_FILE:-/var/data/secrets/proton-pat}
BIN_DIR=${SECRETS_BIN_DIR:-/var/data/bin}
SESSION_DIR=${SECRETS_SESSION_DIR:-/run/secrets-sync}
LOCK=${SECRETS_LOCK:-/run/secrets-sync.lock}
HOSTNAME_FILE=${SECRETS_HOSTNAME_FILE:-/etc/hostname}
RELEASE_URL=${SECRETS_RELEASE_URL:-https://github.com/protonpass/pass-cli/releases/download}
APPS_BRANCH=${APPS_BRANCH:-main}

die() { echo "secrets-sync: $*" >&2; exit 1; }

# Per-run state (globals: the EXIT trap runs after main returns).
work=
TOKEN=
PC=
NODE=
SRC=
LOGGED_IN=0
declare -a TMPS=()                                   # temp files to remove on exit
declare -a T_TPL=() T_DEST=() T_MODE=() T_OWNER=() T_UNITS=() T_TMP=()   # manifest targets, parallel arrays

# shellcheck disable=SC2329 # runs as the EXIT trap
cleanup() {
    local rc=$?
    trap - EXIT
    if [ "$LOGGED_IN" -eq 1 ]; then pc logout > /dev/null 2>&1 || true; fi
    if [ "${#TMPS[@]}" -gt 0 ]; then rm -f "${TMPS[@]}"; fi
    [ -z "$work" ] || rm -rf "$work"
    rm -rf "$SESSION_DIR"
    exit "$rc"
}

pc() { timeout "${SECRETS_TIMEOUT:-60}" "$PC" "$@"; }

# pc_failed <what> <stderr file>: report a pass-cli failure; pass-cli's stderr never holds values, but scrub the token anyway.
pc_failed() {
    local msg
    msg=$(< "$2")
    msg=${msg//"$TOKEN"/'***'}
    msg=${msg//"${TOKEN#*::}"/'***'}
    die "$1 failed: ${msg:-no output}"
}

read_token() {
    local line n=0 tok=
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [ -n "$line" ] || continue
        n=$((n + 1))
        tok=$line
    done < "$PAT_FILE"
    [ "$n" -eq 1 ] || die "$PAT_FILE must contain exactly one line (the personal access token)"
    tok=${tok#PROTON_PASS_PERSONAL_ACCESS_TOKEN=}
    [[ $tok =~ ^pst_[^[:space:]:]+::[^[:space:]]+$ ]] || die "$PAT_FILE does not hold a Proton Pass personal access token (pst_...::...)"
    TOKEN=$tok
}

node_name() {
    local n
    [ -f "$HOSTNAME_FILE" ] || die "$HOSTNAME_FILE not found"
    n=$(head -n1 "$HOSTNAME_FILE")
    n=${n%%.*}
    [[ $n =~ ^[A-Za-z0-9_-]+$ ]] || die "cannot derive a node name from $HOSTNAME_FILE"
    NODE=$n
}

# fetch_repo: SRC = repo root (tarball like apps-sync, or SECRETS_SRC_DIR).
fetch_repo() {
    if [ -n "${SECRETS_SRC_DIR:-}" ]; then
        SRC=$SECRETS_SRC_DIR
    else
        [ -n "${APPS_REPO_URL:-}" ] || die "APPS_REPO_URL is not set (see /etc/apps-sync.env)"
        curl -fsSL --retry 3 --max-time 120 -o "$work/repo.tar.gz" \
            "${APPS_REPO_URL%/}/archive/refs/heads/$APPS_BRANCH.tar.gz" || die "downloading the repo failed"
        mkdir "$work/repo"
        tar -xzf "$work/repo.tar.gz" -C "$work/repo" --strip-components=1
        SRC=$work/repo
    fi
    [ -d "$SRC/secrets" ] || die "no secrets/ directory in the repo, refusing to continue"
}

sha_of() { sha256sum "$1" | cut -d' ' -f1; }

# ensure_pass_cli: PC = verified pinned binary, downloaded on demand into BIN_DIR.
ensure_pass_cli() {
    local pin=$SRC/secrets/pass-cli.version k v tmp old version='' sha=''
    [ -f "$pin" ] || die "secrets/pass-cli.version not found in the repo"
    while IFS='=' read -r k v || [ -n "$k" ]; do
        case $k in
            version) version=$v ;;
            sha256) sha=$v ;;
        esac
    done < "$pin"
    [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "secrets/pass-cli.version: missing or invalid version=x.y.z"
    [[ $sha =~ ^[0-9a-f]{64}$ ]] || die "secrets/pass-cli.version: missing or invalid sha256="
    PC=$BIN_DIR/pass-cli-$version
    if [ -x "$PC" ] && [ "$(sha_of "$PC")" = "$sha" ]; then return; fi
    install -d -m 0755 "$BIN_DIR"
    tmp=$(mktemp "$BIN_DIR/.pass-cli.XXXXXX")
    TMPS+=("$tmp")
    curl -fsSL --retry 3 --max-time 600 -o "$tmp" "$RELEASE_URL/$version/pass-cli-linux-x86_64" \
        || die "downloading pass-cli $version failed"
    [ "$(sha_of "$tmp")" = "$sha" ] || die "pass-cli $version: checksum mismatch, refusing to use the download"
    chmod 0755 "$tmp"
    mv -f "$tmp" "$PC"
    for old in "$BIN_DIR"/pass-cli-*; do
        [ "$old" = "$PC" ] || rm -f "$old"
    done
}

# read_manifest: validate targets.conf into the T_* arrays before touching the network.
read_manifest() {
    local conf=$SRC/secrets/targets.conf tpl dest mode owner units extra
    [ -f "$conf" ] || die "secrets/targets.conf not found in the repo"
    while read -r tpl dest mode owner units extra || [ -n "${tpl:-}" ]; do
        [ -n "${tpl:-}" ] && [[ $tpl != \#* ]] || continue
        [ -z "${extra:-}" ] || die "targets.conf: too many fields for $tpl"
        [[ $tpl =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "targets.conf: invalid template name '$tpl'"
        [[ ${dest:-} =~ ^/[^[:space:]]*[^[:space:]/]$ ]] || die "targets.conf: $tpl needs an absolute destination"
        [[ ${mode:-} =~ ^[0-7]{3,4}$ ]] || die "targets.conf: $tpl needs an octal mode"
        [[ ${owner:-} =~ ^(-|[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+)$ ]] || die "targets.conf: $tpl needs owner:group or -"
        [[ ${units:-} =~ ^(-|[A-Za-z0-9_.@:-]+(,[A-Za-z0-9_.@:-]+)*)$ ]] || die "targets.conf: $tpl needs units (comma separated) or -"
        [ -f "$SRC/secrets/$tpl" ] || die "template $tpl (named in targets.conf) not found in secrets/"
        T_TPL+=("$tpl") T_DEST+=("$dest") T_MODE+=("$mode") T_OWNER+=("$owner") T_UNITS+=("$units")
    done < "$conf"
    [ "${#T_TPL[@]}" -gt 0 ] || die "targets.conf lists no targets"
}

login() {
    local err=$work/err
    export PROTON_PASS_PERSONAL_ACCESS_TOKEN=$TOKEN
    LOGGED_IN=1 # logout is harmless after a failed login and cleans up a half-created session
    pc login > /dev/null 2> "$err" || pc_failed "Proton Pass login" "$err"
    unset PROTON_PASS_PERSONAL_ACCESS_TOKEN
}

# render <template> <temp file>: expand the template into the temp file (mode 0600 from creation).
render() {
    local line key val value err=$work/err
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line//'{node}'/$NODE}
        if [[ $line != *=* ]] || [[ $line =~ ^[[:space:]]*# ]]; then
            printf '%s\n' "$line" >> "$2"
            continue
        fi
        key=${line%%=*}
        val=${line#*=}
        if [[ $val == pass://* ]]; then
            value=$(pc item view "$val" 2> "$err") || pc_failed "fetching $val" "$err"
            [ -n "$value" ] || die "$val is empty"
            [[ $value != *$'\n'* ]] || die "$val has a multi-line value, which a dotenv file cannot hold"
            printf '%s=%s\n' "$key" "$value" >> "$2"
        elif [[ $val == *pass://* ]]; then
            die "$1: $key mixes a pass:// reference with other text; the whole value must be the reference"
        else
            printf '%s\n' "$line" >> "$2"
        fi
    done < "$SRC/secrets/$1"
}

render_all() {
    local i dest
    for i in "${!T_TPL[@]}"; do
        dest=${T_DEST[$i]}
        mkdir -p "${dest%/*}"
        T_TMP[i]=$(mktemp "${dest%/*}/.${dest##*/}.XXXXXX")
        TMPS+=("${T_TMP[$i]}")
        render "${T_TPL[$i]}" "${T_TMP[$i]}"
    done
}

# commit_all: replace changed destinations (atomic rename), echo the units of changed targets.
commit_all() {
    local i tmp dest
    for i in "${!T_TPL[@]}"; do
        tmp=${T_TMP[$i]}
        dest=${T_DEST[$i]}
        chmod "${T_MODE[$i]}" "$tmp"
        [ "${T_OWNER[$i]}" = - ] || chown "${T_OWNER[$i]}" "$tmp"
        if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
            chmod "${T_MODE[$i]}" "$dest"
            [ "${T_OWNER[$i]}" = - ] || chown "${T_OWNER[$i]}" "$dest"
            rm -f "$tmp"
        else
            mv -f "$tmp" "$dest"
            echo "secrets-sync: updated $dest" >&2
            [ "${T_UNITS[$i]}" = - ] || echo "${T_UNITS[$i]}" | tr ',' '\n'
        fi
    done > "$work/units"
    echo "secrets-sync: ok, ${#T_TPL[@]} target(s)" >&2
}

main() {
    local unit rc=0
    exec 9> "$LOCK"
    flock 9
    if [ ! -f "$PAT_FILE" ]; then
        echo "secrets-sync: no Proton Pass token at $PAT_FILE, nothing to do (push one with scripts/push-token.sh)"
        exit 0
    fi
    work=$(mktemp -d)
    trap cleanup EXIT
    read_token
    node_name
    fetch_repo
    read_manifest
    ensure_pass_cli
    # pass-cli keeps its session, key and settings under HOME/XDG and PROTON_PASS_SESSION_DIR: all on tmpfs.
    rm -rf "$SESSION_DIR"
    install -d -m 0700 "$SESSION_DIR" "$SESSION_DIR/home"
    export HOME=$SESSION_DIR/home XDG_DATA_HOME=$SESSION_DIR/home/data XDG_CONFIG_HOME=$SESSION_DIR/home/config \
        XDG_CACHE_HOME=$SESSION_DIR/home/cache PROTON_PASS_SESSION_DIR=$SESSION_DIR/pass-session PROTON_PASS_KEY_PROVIDER=fs
    login
    render_all
    commit_all
    while read -r unit; do
        systemctl restart "$unit" || { echo "secrets-sync: restarting $unit failed" >&2; rc=1; }
    done < <(sort -u "$work/units")
    exit "$rc"
}

main "$@"
