#!/bin/bash
# Reconcile apps/<name>/* from the repo into the Quadlet directory.
#   apps-sync                                      download the repo tarball and reconcile all apps
#   apps-sync reset [--include-persistent] <app>   wipe <app>'s container, network and volumes and redeploy it
# README* files in an app dir are documentation: never deployed (a copy an older apps-sync left behind is removed
# quietly, without daemon-reload or restart). A .volume file with the comment line "# apps-sync: keep" is persistent:
# reset keeps that volume unless --include-persistent is given.
# Env: APPS_REPO_URL, APPS_BRANCH, APPS_LIST (space separated apps this node runs). The systemd unit gets them from
#      /etc/apps-sync.env (EnvironmentFile); run by hand, apps-sync reads APPS_ENV_FILE (default /etc/apps-sync.env)
#      itself for every one of them that is not already set in the environment (the environment wins).
#      APPS_SRC_DIR (local repo root instead of downloading; for tests),
#      APPS_DIR (managed dir), APPS_LOCK (lock file).
# Apps: precedence of the list of apps this node runs (the node name is the short hostname, APPS_HOSTNAME_FILE, default
#   /etc/hostname, like secrets-sync):
#   1. APPS_LIST set in the environment (manual runs, tests; may be empty = no apps), except under systemd, where the
#      unit's EnvironmentFile= makes it the baked value;
#   2. the `apps:` line of nodes/<node>.yml in the downloaded repo copy, read on every run. Only a single-line flow list
#      is understood: `apps: [a, b]` or `apps: []` (names [a-z0-9-], ", " separated, optional trailing # comment). A
#      missing, repeated or malformed line aborts the run before anything is changed (a typo never removes every app);
#   3. no nodes/<node>.yml in the repo: the baked APPS_LIST from /etc/apps-sync.env; unset = no apps.
# A deployed app that is not in the list (or not in the repo) is stopped and removed like a removed app (volumes are
# never deleted). `reset` uses the same resolved list.
# A deployed or removed *.yml|*.yaml|*.toml file (Traefik route files) triggers `systemctl reload traefik.service` after the
# restarts: Traefik's directory watcher does not see changes in subdirectories. A failing or missing reload is ignored.
# Routes follow the app they route to: on a node that lists `traefik`, apps/<app>/routes.{yml,yaml,toml} of every app listed
#   on ANY node (all nodes/*.yml, same parser, a malformed file aborts the run) is deployed to $APPS_DIR/<app>/ with only the
#   route files present, never quadlets: a route-only dir creates, starts and resets nothing. It is removed like any removed
#   file once no node lists the app any more. `reset <app>` of such an app is refused (not in this node's APPS_LIST).
set -euo pipefail

APPS_ENV_FILE=${APPS_ENV_FILE:-/etc/apps-sync.env}
APPS_HOSTNAME_FILE=${APPS_HOSTNAME_FILE:-/etc/hostname}
# APPS_LIST set by the caller is final. Under systemd (INVOCATION_ID) the installed unit's EnvironmentFile= puts the baked
# list there too: that one is only the fallback, so drop it and let load_env_file bring it back.
APPS_LIST_FIXED=0
if [ -n "${APPS_LIST+x}" ]; then
    if [ -n "${INVOCATION_ID:-}" ]; then unset APPS_LIST; else APPS_LIST_FIXED=1; fi
fi

# load_env_file: set each of the three variables from the env file unless it is already set (even empty).
load_env_file() {
    local v val
    [ -r "$APPS_ENV_FILE" ] || return 0
    for v in APPS_REPO_URL APPS_BRANCH APPS_LIST; do
        [ -z "${!v+x}" ] || continue
        # shellcheck source=/dev/null
        val=$(. "$APPS_ENV_FILE" > /dev/null 2>&1 && [ -n "${!v+x}" ] && printf x%s "${!v}") || true
        [ -z "$val" ] || printf -v "$v" %s "${val#x}"
    done
}
load_env_file

APPS_DIR=${APPS_DIR:-/etc/containers/systemd/apps}
APPS_LIST=${APPS_LIST:-}
APPS_LOCK=${APPS_LOCK:-/run/apps-sync.lock}
APPS_BRANCH=${APPS_BRANCH:-main}

die() { echo "apps-sync: $*" >&2; exit 1; }

# Quadlet file extension -> unit suffix (see podman-systemd.unit(5)).
unit_suffix() {
    case $1 in
        container | kube) echo ".service" ;;
        volume) echo "-volume.service" ;;
        network) echo "-network.service" ;;
        pod) echo "-pod.service" ;;
        build) echo "-build.service" ;;
        image) echo "-image.service" ;;
        *) return 1 ;;
    esac
}

# is_doc <file>: README* (any case) is documentation, not part of the deployment.
is_doc() {
    local f=${1##*/}
    [[ ${f,,} == readme* ]]
}

# unit_of <file>: unit name for a Quadlet file, empty for other files.
unit_of() {
    local f=${1##*/} suffix
    suffix=$(unit_suffix "${f##*.}") || return 0
    echo "${f%.*}$suffix"
}

# Restart order: networks, volumes, everything else, containers/kube last.
rank() {
    case ${1##*.} in
        network) echo 0 ;;
        volume) echo 1 ;;
        container | kube | pod) echo 3 ;;
        *) echo 2 ;;
    esac
}

# setting <file> <Key>: first value of Key= in a Quadlet file.
setting() { sed -n "s/^$2=//p" "$1" | head -n1; }

# Per-run state.
declare -a CHANGED=() # "<app>/<file>" copied or updated
declare -a ROUTE_APPS=() # apps of any node whose route files this Traefik node deploys (see resolve_remote_routes)
REMOVED=0
ROUTES=0 # a route file (.yml/.yaml/.toml) was deployed, updated or removed

note_route() {
    case ${1##*.} in yml | yaml | toml) ROUTES=1 ;; esac
}

fetch() {
    local work=$1
    if [ -n "${APPS_SRC_DIR:-}" ]; then
        SRC=$APPS_SRC_DIR
        return
    fi
    [ -n "${APPS_REPO_URL:-}" ] || die "APPS_REPO_URL is not set (see /etc/apps-sync.env)"
    curl -fsSL --retry 3 --max-time 120 -o "$work/repo.tar.gz" \
        "${APPS_REPO_URL%/}/archive/refs/heads/$APPS_BRANCH.tar.gz"
    mkdir "$work/repo"
    tar -xzf "$work/repo.tar.gz" -C "$work/repo" --strip-components=1
    SRC=$work/repo
}

# deploy <app>...: copy changed files of the given apps, record them.
deploy() {
    local app f dest
    for app in "$@"; do
        for f in "$SRC/apps/$app"/*; do
            [ -f "$f" ] && [ ! -L "$f" ] || continue
            ! is_doc "$f" || continue
            dest=$APPS_DIR/$app/${f##*/}
            if ! cmp -s "$f" "$dest"; then
                install -D -m 0644 "$f" "$dest"
                CHANGED+=("$app/${f##*/}")
                note_route "$f"
            fi
        done
    done
}

# wanted <app>: the node runs it (listed) and the repo has it.
wanted() {
    local a
    for a in $APPS_LIST; do
        [ "$a" = "$1" ] && [ -d "$SRC/apps/$1" ] && return 0
    done
    return 1
}

# is_route_file <name>: routes.yml|yaml|toml, the only files of an app other nodes' Traefik deploys.
is_route_file() {
    [[ $1 == routes.yml || $1 == routes.yaml || $1 == routes.toml ]]
}

# remote_route <app> <file>: a route file of an app of another node that this Traefik node must keep.
remote_route() {
    local a
    is_route_file "$2" && [ -f "$SRC/apps/$1/$2" ] || return 1
    for a in "${ROUTE_APPS[@]}"; do [ "$a" = "$1" ] && return 0; done
    return 1
}

# deploy_routes <app>: like deploy, route files only; not recorded in CHANGED (no unit is touched).
deploy_routes() {
    local f dest app=$1
    for f in "$SRC/apps/$app"/*; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        is_route_file "${f##*/}" || continue
        dest=$APPS_DIR/$app/${f##*/}
        if ! cmp -s "$f" "$dest"; then
            install -D -m 0644 "$f" "$dest"
            ROUTES=1
        fi
    done
}

# prune: remove managed files whose repo counterpart vanished or whose app is not wanted, stop their units.
prune() {
    local d f app name unit
    [ -d "$APPS_DIR" ] || return 0
    for d in "$APPS_DIR"/*/; do
        [ -d "$d" ] || continue
        app=$(basename "$d")
        for f in "$d"*; do
            [ -e "$f" ] || continue
            name=${f##*/}
            if is_doc "$name"; then
                rm -f "$f"
                continue
            fi
            ! wanted "$app" || [ ! -f "$SRC/apps/$app/$name" ] || continue
            ! remote_route "$app" "$name" || continue
            unit=$(unit_of "$name")
            [ -z "$unit" ] || systemctl stop "$unit" || true
            rm -f "$f"
            note_route "$name"
            REMOVED=1
        done
        rmdir "$d" 2> /dev/null || true
    done
}

# units_to_restart: unit names for CHANGED files, ordered by rank.
units_to_restart() {
    local c app name unit g
    for c in "${CHANGED[@]}"; do
        app=${c%%/*}
        name=${c#*/}
        unit=$(unit_of "$name")
        if [ -n "$unit" ]; then
            echo "$(rank "$name") $unit"
        else # plain file (env file, config): restart the app's containers
            for g in "$APPS_DIR/$app"/*.container; do
                [ -f "$g" ] && echo "3 $(unit_of "$g")"
            done
        fi
    done | sort -u -k1,1n -k2,2 | cut -d' ' -f2
}

reconcile() {
    local app unit
    [ -d "$SRC/apps" ] || die "no apps/ directory in the repo, refusing to reconcile"
    local -a apps=()
    for app in $APPS_LIST; do
        if [ -d "$SRC/apps/$app" ]; then apps+=("$app"); else echo "apps-sync: listed app '$app' is not in the repo" >&2; fi
    done
    if [ "${#apps[@]}" -gt 0 ]; then deploy "${apps[@]}"; fi
    # Apps of other nodes: only their route files, never units (no CHANGED entry, so no daemon-reload or restart).
    for app in "${ROUTE_APPS[@]}"; do
        if [ -d "$SRC/apps/$app" ] && ! wanted "$app"; then deploy_routes "$app"; fi
    done
    prune
    [ "${#CHANGED[@]}" -gt 0 ] || [ "$REMOVED" -eq 1 ] || [ "$ROUTES" -eq 1 ] || return 0
    if [ "${#CHANGED[@]}" -gt 0 ] || [ "$REMOVED" -eq 1 ]; then systemctl daemon-reload; fi
    if [ "${#CHANGED[@]}" -gt 0 ]; then
        while read -r unit; do
            systemctl restart "$unit"
        done < <(units_to_restart)
    fi
    if [ "$ROUTES" -eq 1 ]; then systemctl reload traefik.service || true; fi
}

# ranked_files <dir> <sort flags>: regular files of an app dir ordered by rank.
ranked_files() {
    local f
    for f in "$1"/*; do
        [ -f "$f" ] && echo "$(rank "$f") $f"
    done | sort "$2" | cut -d' ' -f2-
}

reset() {
    local app=$1 include=$2 dir name unit f
    local -a recreated=() # network units whose network was removed: restart (the oneshot unit stays active)
    [[ " $APPS_LIST " == *" $app "* ]] || die "app '$app' is not in APPS_LIST"
    dir=$SRC/apps/$app
    [ -d "$dir" ] || die "no app '$app' in the repo"
    # Stop containers first, then volumes. Never stop a .network unit: Quadlet gives every container that uses the
    # network (also other apps', e.g. traefik.network) Requires= on it, so the stop would propagate to them.
    while read -r f; do
        unit=$(unit_of "$f")
        [ -z "$unit" ] || [[ $f == *.network ]] || systemctl stop "$unit" || true
    done < <(ranked_files "$dir" -rn)
    for f in "$dir"/*.container; do
        [ -f "$f" ] || continue
        name=$(setting "$f" ContainerName)
        podman rm -f --ignore "${name:-systemd-$(basename "${f%.*}")}"
    done
    # Networks hold no data: always remove them, so a changed Subnet= takes effect (Quadlet creates with `--ignore`
    # and would reuse the old one). Still in use (shared network of another app): warn and keep going.
    for f in "$dir"/*.network; do
        [ -f "$f" ] || continue
        name=$(setting "$f" NetworkName)
        name=${name:-systemd-$(basename "${f%.*}")}
        podman network exists "$name" || continue
        if podman network rm "$name"; then
            recreated+=("$(unit_of "$f")")
        else
            echo "apps-sync: network $name could not be removed (still in use?), kept" >&2
        fi
    done
    for f in "$dir"/*.volume; do
        [ -f "$f" ] || continue
        name=$(setting "$f" VolumeName)
        name=${name:-systemd-$(basename "${f%.*}")}
        if [ "$include" -eq 0 ] && grep -qxF '# apps-sync: keep' "$f"; then
            echo "apps-sync: kept persistent volume $name (--include-persistent removes it)" >&2
            continue
        fi
        podman volume rm -f "$name"
    done
    deploy "$app"
    systemctl daemon-reload
    while read -r f; do
        unit=$(unit_of "$f")
        if [ -z "$unit" ]; then continue; fi
        if [[ " ${recreated[*]:-} " == *" $unit "* ]]; then systemctl restart "$unit"; else systemctl start "$unit"; fi
    done < <(ranked_files "$dir" -n)
}

# parse_reset [--include-persistent] <app> (option in any position)
parse_reset() {
    local a app='' include=0
    for a in "$@"; do
        case $a in
            --include-persistent) include=1 ;;
            -*) die "usage: apps-sync reset [--include-persistent] <app>" ;;
            *) [ -z "$app" ] || die "usage: apps-sync reset [--include-persistent] <app>"; app=$a ;;
        esac
    done
    [ -n "$app" ] || die "usage: apps-sync reset [--include-persistent] <app>"
    reset "$app" "$include"
}

# apps_of <file>: the apps of a nodes/<node>.yml `apps:` line (space separated), dies on a missing/repeated/malformed line.
apps_of() {
    local f=$1 line list='' count=0
    local re='^apps: \[(([a-z0-9][a-z0-9-]*)(, [a-z0-9][a-z0-9-]*)*)?\][[:space:]]*(#.*)?$'
    while IFS= read -r line || [ -n "$line" ]; do
        [[ $line == apps:* ]] || continue
        count=$((count + 1))
        [[ $line =~ $re ]] || die "${f#"$SRC"/}: malformed apps line '$line' (want: apps: [a, b] or apps: []), nothing changed"
        list=${BASH_REMATCH[1]}
    done < "$f"
    [ "$count" -eq 1 ] || die "${f#"$SRC"/}: need exactly one 'apps: [a, b]' line, found $count, nothing changed"
    echo "${list//,/ }"
}

# resolve_list: APPS_LIST = what this node runs, before anything is touched (see precedence in the header).
resolve_list() {
    [ "$APPS_LIST_FIXED" -eq 0 ] || return 0
    local f n
    [ -f "$APPS_HOSTNAME_FILE" ] || die "$APPS_HOSTNAME_FILE not found"
    n=$(head -n1 "$APPS_HOSTNAME_FILE")
    n=${n%%.*}
    [[ $n =~ ^[A-Za-z0-9_-]+$ ]] || die "cannot derive a node name from $APPS_HOSTNAME_FILE"
    f=$SRC/nodes/$n.yml
    [ -f "$f" ] || return 0 # keep the baked list
    APPS_LIST=$(apps_of "$f")
}

# resolve_remote_routes: on a Traefik node, ROUTE_APPS = apps listed on any node (all nodes/*.yml), whose routes.* it needs.
resolve_remote_routes() {
    local f a list
    [[ " $APPS_LIST " == *" traefik "* ]] || return 0
    for f in "$SRC"/nodes/*.yml; do
        [ -f "$f" ] || continue
        list=$(apps_of "$f") # separate statement: a die inside `for ... in $(...)` would not abort
        for a in $list; do ROUTE_APPS+=("$a"); done
    done
}

main() {
    exec 9> "$APPS_LOCK"
    flock 9
    work=$(mktemp -d) # global: the EXIT trap runs after main returns
    trap 'rm -rf "$work"' EXIT
    fetch "$work"
    resolve_list
    resolve_remote_routes
    case ${1:-sync} in
        sync) reconcile ;;
        reset) shift; parse_reset "$@" ;;
        *) die "usage: apps-sync [reset [--include-persistent] <app>]" ;;
    esac
}

main "$@"
